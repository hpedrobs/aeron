# ============================================================
# SEFAZ RPA - Configurações de Ambiente
# ============================================================

# ----------------------------------------------------------
# MongoDB
# URI de conexão com o banco de dados MongoDB.
# Padrão local: mongodb://localhost:27017/aeron
# ----------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/aeron

# ----------------------------------------------------------
# API PFX Manager
# URL base da API responsável por gerenciar os certificados
# digitais (.pfx) utilizados para autenticação no portal SEFAZ.
# Padrão local: http://localhost:5000
# ----------------------------------------------------------
API_PFX_MANAGER=http://localhost:5000

# ----------------------------------------------------------
# Estrutura de pastas para salvar as notas fiscais baixadas.
# O caminho deve ser absoluto. Os arquivos serão organizados
# automaticamente por modelo de nota, empresa e período.
# Exemplo Windows: C:\notes
# ----------------------------------------------------------
STRUCTURE=C:\notes

# ----------------------------------------------------------
# Filtro de notas a processar (opcional)
# CANCELADA="true"
# AUTORIZADA="true"
# ----------------------------------------------------------
